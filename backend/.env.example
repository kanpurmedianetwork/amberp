# Ambica Engineers ERP — Backend Environment Configuration (100% Free Tier)
PORT=5000
JWT_SECRET=ambica-engineers-production-secret-key-2026
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2 Object Storage (10 GB / Month Free Tier, $0 Egress/Bandwidth Fees)
# Optional: If omitted, documents are stored on server disk and served locally
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ambica-erp-docs
# Public custom domain or R2 dev subdomain (e.g., https://pub-xxxx.r2.dev or https://docs.ambicaengineers.in)
R2_PUBLIC_URL=
